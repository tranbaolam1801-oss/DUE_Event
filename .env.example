# Local development defaults; no cloud credentials are needed.
NODE_ENV=development
DATABASE_URL=file:./dev.db
JWT_SECRET=
CORS_ORIGIN=*

# Production-only backend values (configure in Vercel, not in source control):
# NODE_ENV=production
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=my_due&sslmode=require
# DIRECT_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres?schema=my_due&sslmode=require
# JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# CORS_ORIGIN=https://YOUR-FRONTEND.vercel.app
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-the-server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=event-attachments-private
# AI_API_KEY=
AI_API_KEY=